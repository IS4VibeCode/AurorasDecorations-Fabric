	"depends": {
		"fabricloader": ">=0.16.9",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"terraform-wood-api-v1": ">=7.0.1"
	},
	"suggests": {
		"emi": "*",
		"trinkets": ">=3.7.1"
